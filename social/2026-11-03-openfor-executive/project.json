 "captions": [
  {
   "start": 0.31,
   "end": 3.67,
   "text": "Every cohort needs current investor and startup research."
  },
  {
   "start": 3.99,
   "end": 6.26,
   "text": "Keeping it up to date by hand is slow."
  },
  {
   "start": 6.74,
   "end": 10.17,
   "text": "With Startup Tarot, one operator keeps that research current,"
  },
  {
   "start": 10.31,
   "end": 12.4,
   "text": "with Codex doing the careful groundwork."
  },
  {
   "start": 12.93,
   "end": 15.4,
   "text": "Founders get a ready-to-open copy of the app"
  },
  {
   "start": 15.4,
   "end": 17.71,
   "text": "to choose their next small experiment."
  },
  {
   "start": 18.4,
   "end": 19.51,
   "text": "People stay in charge."
  },
  {
   "start": 19.96,
   "end": 21.74,
   "text": "Every release needs human approval,"
  },
  {
   "start": 21.87,
   "end": 24.38,
   "text": "and nothing is published or sent automatically."
  },
  {
   "start": 24.98,
   "end": 27.3,
   "text": "Private contact data stays out of releases,"
  },
  {
   "start": 27.3,
   "end": 28.95,
   "text": "and every change is versioned,"
  },
  {
   "start": 28.95,
   "end": 30.77,
   "text": "so earlier versions can be restored."
  },
  {
   "start": 31.55,
   "end": 34.62,
   "text": "We've demonstrated it with synthetic data on a local setup."
  },
  {
   "start": 34.83,
   "end": 37.19,
   "text": "It hasn't been tried with OpenFor's data yet."
  },
  {
   "start": 37.75,
   "end": 40.02,
   "text": "We're asking for one operator and a small,"
  },
  {
   "start": 40.15,
   "end": 42.06,
   "text": "authorized dataset to run a pilot."
  }
 ],
