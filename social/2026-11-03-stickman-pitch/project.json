 "captions": [
  {
   "start": 0.35,
   "end": 2.02,
   "text": "You've pitched forty investors."
  },
  {
   "start": 2.41,
   "end": 3.53,
   "text": "Most never wrote back."
  },
  {
   "start": 3.9,
   "end": 5.3,
   "text": "Wrong-fit funders."
  },
  {
   "start": 5.49,
   "end": 6.4,
   "text": "Vague advice."
  },
  {
   "start": 6.6,
   "end": 7.76,
   "text": "No clear next step."
  },
  {
   "start": 8.36,
   "end": 9.35,
   "text": "Startup Tarot compares"
  },
  {
   "start": 9.35,
   "end": 10.4,
   "text": "your startup"
  },
  {
   "start": 10.4,
   "end": 11.55,
   "text": "with real investor criteria"
  },
  {
   "start": 11.55,
   "end": 12.65,
   "text": "and dated examples."
  },
  {
   "start": 12.85,
   "end": 14.52,
   "text": "See where you fit,"
  },
  {
   "start": 14.97,
   "end": 15.94,
   "text": "where you don't,"
  },
  {
   "start": 16.18,
   "end": 16.92,
   "text": "and what evidence"
  },
  {
   "start": 17.24,
   "end": 19.21,
   "text": "would close the gap."
  },
  {
   "start": 19.74,
   "end": 21.12,
   "text": "Then get one small,"
  },
  {
   "start": 21.27,
   "end": 22.68,
   "text": "evidence-backed experiment:"
  },
  {
   "start": 23.04,
   "end": 24.14,
   "text": "your next move."
  },
  {
   "start": 24.59,
   "end": 26.25,
   "text": "It's free and runs in your browser."
  },
  {
   "start": 26.78,
   "end": 27.31,
   "text": "Try the demo."
  }
 ],
